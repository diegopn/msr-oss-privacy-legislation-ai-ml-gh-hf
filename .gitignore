.env
.codex/
.Rlibrary/
.Rhistory
.RData
.idea/
.quarto/
_site/
.run-lock/
# Keep the input folder structure, but never version collected data.
inputs/data/**
!inputs/data/**/
!inputs/data/**/.gitkeep
inputs/raw/**
!inputs/raw/**/
!inputs/raw/**/.gitkeep
inputs/final/**
!inputs/final/**/
!inputs/final/**/.gitkeep

# Outputs are generated; preserve only their directory structure.
outputs/**
!outputs/**/
!outputs/**/.gitkeep

**/*.quarto_ipynb

/.quarto/
